# Pomerium Zero Configuration
# Get this token from https://console.pomerium.com/ when creating your cluster
POMERIUM_ZERO_TOKEN=your-token-here

# Your Pomerium Zero cluster domain (e.g., fantastic-fox-1234.pomerium.app)
# Found in your Pomerium Zero console after cluster creation
POMERIUM_CLUSTER_DOMAIN=your-cluster.pomerium.app

# Pomerium Zero API user token, used by ./bootstrap.sh to set the cluster's
# SSH config (host keys + User CA), create the policy, and create the SSH
# and web routes. Generate one at:
#   https://console.pomerium.app/app/management/api-tokens
# After bootstrap completes you can revoke it; the script prompts you to.
POMERIUM_ZERO_API_TOKEN=your-api-user-token-here

# The IdP email allowed by the route policy. The script writes a policy
# that only permits this exact email to reach OpenClaw through Pomerium.
OPERATOR_EMAIL=you@example.com

# OpenClaw version to install in OpenClaw container
OPENCLAW_VERSION=2026.2.15 # defaults to latest stable release if not set
