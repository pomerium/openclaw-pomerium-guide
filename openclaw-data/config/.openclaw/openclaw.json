{
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "configure-gateway-token",
      "trustedProxy": {
        "userHeader": "X-Pomerium-Claim-Email",
        "requiredHeaders": ["X-Pomerium-Jwt-Assertion"]
      }
    },
    "trustedProxies": ["172.30.0.10"],
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  }
}
